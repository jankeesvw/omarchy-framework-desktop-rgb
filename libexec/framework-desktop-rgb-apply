#!/usr/bin/bash
# Runs as root, through sudo. Takes one argument: between one and eight
# colours as RRGGBB, comma separated, and paints the eight LEDs on the
# Framework Desktop fan with them. Fewer than eight colours repeat around
# the ring. Nothing else.
#
# This is the only thing the sudoers rule allows, so it trusts no argument:
# anything that is not that exact shape is refused before framework_tool runs.
set -euo pipefail
PATH=/usr/bin:/bin

LEDS=8

if [ "$#" -ne 1 ] || [[ ! "$1" =~ ^[0-9A-Fa-f]{6}(,[0-9A-Fa-f]{6}){0,7}$ ]]; then
  echo "usage: framework-desktop-rgb-apply RRGGBB[,RRGGBB...] (up to 8)" >&2
  exit 2
fi

IFS=, read -r -a colours <<< "$1"

args=()
for ((i = 0; i < LEDS; i++)); do
  args+=("0x${colours[i % ${#colours[@]}]}")
done

exec /usr/bin/framework_tool --rgbkbd 0 "${args[@]}"
